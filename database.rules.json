{
  "rules": {
    "devices": {
      ".read": true,
      ".write": true
    },
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "$other": {
      ".read": false,
      ".write": false
    }
  }
}
