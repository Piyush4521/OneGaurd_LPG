{
  "name": "onegaurd-lpg",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "OneGaurd LPG Leak Detection and Cylinder Mass Telemetry System",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "server": "tsx server/index.ts",
    "start": "tsx server/index.ts",
    "start:all": "concurrently -k -p \"[{name}]\" -n \"SERVER,CLIENT\" -c \"cyan,emerald\" \"npm run server\" \"npm run dev\"",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "deploy": "firebase deploy --only hosting"
  },
  "dependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "firebase": "^10.14.1",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "firebase-tools": "^13.29.1",
    "vitest": "^3.0.6"
  }
}
