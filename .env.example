# OneGaurd LPG Environment Configuration Template
# NOTE: Never commit sensitive keys or service-account secrets to source control.

# Server Configuration
PORT=5000
NODE_ENV=development
DEVICE_SECRET_KEY=replace_with_secure_esp32_gateway_key
ALLOWED_ORIGINS=http://localhost:3000,https://app.onegaurd.com

# Firebase Configuration (Optional in local simulation mode)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_DATABASE_URL=

# Frontend Configuration (Vite)
VITE_API_BASE_URL=
VITE_DEMO_MODE=true
VITE_CUSTOM_DOMAIN=app.onegaurd.com
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_APP_ID=

# Alert Provider Config (Twilio / Mock)
ALERT_PROVIDER_ENABLED=false
ALERT_TWILIO_ACCOUNT_SID=
ALERT_TWILIO_AUTH_TOKEN=
ALERT_TWILIO_PHONE_NUMBER=

# Telegram Bot Alert Gateway (BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Android MacroDroid Jio Call Bridge
MACRODROID_WEBHOOK_URL=
EMERGENCY_PHONE_NUMBER=
ALERT_COOLDOWN_SECONDS=60

