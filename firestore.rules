rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Strictly enforce that authenticated users can only access their own user document and subcollections
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Explicitly deny read and write access to all other document paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
